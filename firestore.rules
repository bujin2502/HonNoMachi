rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        /** Provjerava ima li trenutni korisnik admin status. */
        function isAdmin() {
            return request.auth != null
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
        }

        /** Provjerava da trenutni korisnik nije suspendiran. */
        function isNotSuspended() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true;
        }

        match /users/{userId} {
            allow create: if request.auth != null;

            allow read: if request.auth != null
                && (request.auth.uid == userId || isAdmin());

            allow update: if isAdmin()
                || (request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'suspended', 'suspendedAt', 'suspendedBy', 'suspendedReason', 'admin'
                    ]));
        }

        match /books/{bookId} {
            allow read: if true;
            allow write: if request.auth != null
                && request.auth.token.email_verified == true
                && isNotSuspended();
        }

        match /audit_logs/{logId} {
            allow read: if isAdmin();
            allow write: if isAdmin();
        }

        match /{document=**} {
            allow read, write: if request.auth != null
                && request.auth.token.email_verified == true
                && isNotSuspended();
        }
    }
}