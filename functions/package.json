{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:app": "firebase deploy --only \"functions:createCheckoutPaymentIntent,functions:addToCartAndReserve,functions:removeFromCartAndRelease,functions:cancelCheckout,functions:releaseExpiredCheckoutSessions,functions:releaseExpiredCartReservations,functions:createWalletTopupIntent,functions:stripeWebhook,functions:stripeWalletWebhook\"",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.1.1",
    "nodemailer": "^6.10.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  }
}
