rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        // Helper: provjera admin statusa trenutnog korisnika
        function isAdmin() {
            return request.auth != null
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
        }

        match /users/{userId} {
            allow create: if request.auth != null;
            // Korisnik moze citati svoj profil, admin moze citati sve profile
            allow read: if request.auth != null
                && (request.auth.uid == userId || isAdmin());
            allow update: if request.auth != null && request.auth.uid == userId;
        }

        match /books/{bookId} {
            allow read: if true;
            allow write: if request.auth != null && request.auth.token.email_verified == true;
        }

        match /{document=**} {
            allow read, write: if request.auth != null && request.auth.token.email_verified == true;
        }
    }
}