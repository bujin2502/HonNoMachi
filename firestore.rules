rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        //Pomoćna funkcija - provjerava admin status trenutnog korisnika
        function isAdmin() {
            return request.auth != null
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
        }

        match /users/{userId} {
            allow create: if request.auth != null;

            //Običan korisnik moze citati svoj profil... Admin moze citati sve profile...
            allow read: if request.auth != null
                && (request.auth.uid == userId || isAdmin());

            allow update: if request.auth != null && request.auth.uid == userId;
        }

        match /books/{bookId} {
            allow read: if true;
            allow write: if request.auth != null && request.auth.token.email_verified == true;
        }

        // Rezervacije su vidljive samo kupcu, prodavaču i administratoru.
        // Lifecycle promjene rezervacija obavlja backend (Cloud Functions).
        match /reservations/{reservationId} {
            allow read: if request.auth != null
                && request.auth.token.email_verified == true
                && (
                    resource.data.buyerUid == request.auth.uid
                    || resource.data.sellerUid == request.auth.uid
                    || isAdmin()
                );
            allow write: if false;
        }

        // Checkout sesije su vidljive kupcu i administratoru.
        // Upise obavlja backend (Cloud Functions).
        match /checkoutSessions/{sessionId} {
            allow read: if request.auth != null
                && request.auth.token.email_verified == true
                && (
                    resource.data.buyerUid == request.auth.uid
                    || isAdmin()
                );
            allow write: if false;
        }

        match /{document=**} {
            allow read, write: if request.auth != null
                && request.auth.token.email_verified == true
                && !document.matches('^reservations/.*')
                && !document.matches('^checkoutSessions/.*');
        }
    }
}
